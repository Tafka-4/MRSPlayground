<!DOCTYPE html>
<html lang="ko">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Emoji Frontend</title>
        <script src="/config.js"></script>
        <script type="module">
            import api from '/public/module/api.js';
            window.testEmoji = async () => {
            try {
                const res = await api.get('/api/emoji/v1');
                alert('OK: ' + JSON.stringify(res));
            } catch (e) {
                alert('ERR: ' + (e?.message || 'unknown'));
            }
            };
            window.testAuth = async () => {
            try {
                const res = await api.get('/api/user/v1/auth/me');
                alert('AUTH OK: ' + JSON.stringify(res));
            } catch (e) {
                alert('AUTH ERR: ' + (e?.message || 'unauthorized'));
            }
            };
        </script>
    </head>
    <body>
        <h1>Emoji Frontend</h1>
        <p>CONSTRUCTION: Emoji Frontend</p>
        <button onclick="testEmoji()">/api/emoji/v1 호출 테스트</button>
        <button onclick="testAuth()">/api/v1/auth/me 인증 테스트</button>
    </body>
</html>


