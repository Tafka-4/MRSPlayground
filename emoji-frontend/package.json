{
  "name": "emoji-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "postbuild": "node ./scripts/copy-static.mjs",
    "start": "node ./dist/index.js",
    "dev": "nodemon --watch src --ext ts,json --exec \"tsx ./src/index.ts\""
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "nodemon": "^3.1.10",
    "tsx": "^4.19.4",
    "typescript": "^5.3.3"
  }
}


