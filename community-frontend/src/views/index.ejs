<!DOCTYPE html>
<html lang="ko">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Community Frontend</title>
        <script src="/config.js"></script>
        <script type="module">
            import api from '/public/module/api.js';
            window.testCommunity = async () => {
            try {
                const res = await api.get('/api/post/v1/health');
                alert('OK: ' + JSON.stringify(res));
            } catch (e) {
                alert('ERR: ' + (e?.message || 'unknown'));
            }
            };
            window.testAuth = async () => {
            try {
                const res = await api.get('/api/user/v1/auth/me');
                alert('AUTH OK: ' + JSON.stringify(res));
            } catch (e) {
                alert('AUTH ERR: ' + (e?.message || 'unauthorized'));
            }
            };
        </script>
    </head>
    <body>
        <h1>Community Frontend</h1>
        <p>CONSTRUCTION: Community Frontend</p>
        <button onclick="testCommunity()">/api/post/v1/health 호출 테스트</button>
        <button onclick="testAuth()">/api/v1/auth/me 인증 테스트</button>
    </body>
</html>


