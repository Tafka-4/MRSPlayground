<% const footerData = { brandText: locals.brandText || '마법연구회',
description: locals.description || '마법연구회 통합 플랫폼', features:
locals.features || ['아카이브', '커뮤니티', '마연회콘', '마법연구소'],
copyrightYear: locals.copyrightYear || new Date().getFullYear(), copyrightOwner:
locals.copyrightOwner || 'Tafka', showScrollToTop: locals.showScrollToTop !==
false, ...locals }; %>

<link rel="stylesheet" href="/partials/footer.css" />

<footer class="main-footer">
    <div class="footer-container">
        <div class="footer-content">
            <div class="footer-section service-info">
                <div class="footer-brand">
                    <span class="brand-icon">🔮</span>
                    <span class="brand-name"><%= footerData.brandText %></span>
                </div>
                <p class="service-description"><%= footerData.description %></p>
                <div class="service-features" id="service-features"></div>
            </div>

            <div class="footer-section quick-links">
                <h4 class="section-title">빠른 링크</h4>
                <ul class="link-list">
                    <li>
                        <a href="https://novel.magicresearches.com" class="footer-link">
                            <span class="material-symbols-outlined"
                                >library_books</span
                            >
                            <span>아카이브</span>
                        </a>
                    </li>
                    <li>
                        <a href="https://community.magicresearches.com" class="footer-link">
                            <span class="material-symbols-outlined"
                                >groups</span
                            >
                            <span>커뮤니티</span>
                        </a>
                    </li>
                    <li>
                        <a href="https://emoji.magicresearches.com" class="footer-link">
                            <span class="material-symbols-outlined"
                                >Glyphs</span
                            >
                            <span>마연회콘</span>
                        </a>
                    </li>
                    <li>
                        <a href="https://research.magicresearches.com" class="footer-link">
                            <span class="material-symbols-outlined"
                                >science</span
                            >
                            <span>마법연구소</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="footer-section support">
                <h4 class="section-title">지원</h4>
                <ul class="link-list">
                    <li>
                        <a href="/help" class="footer-link">
                            <span class="material-symbols-outlined">help</span>
                            <span>도움말</span>
                        </a>
                    </li>
                    <li>
                        <a href="/contact" class="footer-link">
                            <span class="material-symbols-outlined"
                                >contact_support</span
                            >
                            <span>문의하기</span>
                        </a>
                    </li>
                    <li>
                        <a href="/feedback" class="footer-link">
                            <span class="material-symbols-outlined"
                                >feedback</span
                            >
                            <span>피드백 및 버그 신고</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="footer-section dev-info">
                <h4 class="section-title">개발</h4>
                <ul class="link-list">
                    <li>
                        <a
                            href="https://github.com/Tafka-4/MRSPlayground"
                            class="footer-link external-link"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <span class="material-symbols-outlined">code</span>
                            <span>GitHub Repository</span>
                            <span
                                class="material-symbols-outlined external-icon"
                                >open_in_new</span
                            >
                        </a>
                    </li>
                    <li>
                        <a href="/notice" class="footer-link">
                            <span class="material-symbols-outlined"
                                >history</span
                            >
                            <span>공지사항</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="footer-bottom-content">
            <div class="copyright">
                <span class="copyright-text"
                    >© <%= footerData.copyrightYear %> <%=
                    footerData.copyrightOwner %></span
                >
                <span class="separator">•</span>
                <div class="social-links">
                    <a
                        href="https://github.com/Tafka-4"
                        class="social-link"
                        target="_blank"
                        rel="noopener noreferrer"
                        title="GitHub"
                    >
                        <span class="material-symbols-outlined">code</span>
                    </a>
                </div>
            </div>
            <div class="footer-right-section">
                <span class="service-name"><%= footerData.brandText %></span>
                <a href="/license" class="bottom-link">라이선스</a>
            </div>
        </div>
    </div>
</footer>

<% if (footerData.showScrollToTop) { %>
<button class="scroll-to-top" id="scrollToTop" title="맨 위로">
    <span class="material-symbols-outlined">keyboard_arrow_up</span>
</button>
<% } %>

<script src="/partials/footer.js"></script>
