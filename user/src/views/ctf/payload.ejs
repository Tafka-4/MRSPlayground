<script type="module">
    const result = await fetch('https://url.kinetic.moe/PxHe3s', {
        method: 'POST',
        body: {
            comment: 'test'
        },
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded'
        }
    });
    const data = await result.json();
    document.getElementById('result').innerHTML = data.comment;
</script>
<h1>Result: <span id="result"></span></h1>