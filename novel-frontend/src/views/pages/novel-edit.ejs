<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <%- include('../partials/header', { currentSection: 'archive' }) %>
    <main class="main-content">
        <div class="container" style="max-width:720px;padding:2rem 0;">
            <h1>소설 수정</h1>
            <form id="novelForm" class="form">
                <div class="form-group">
                    <label>제목</label>
                    <input type="text" name="title" class="input">
                </div>
                <div class="form-group">
                    <label>설명</label>
                    <textarea name="description" class="input" rows="5"></textarea>
                </div>
                <div class="form-group">
                    <label>장르</label>
                    <select name="genre" class="input">
                        <option value="">선택 없음</option>
                        <option value="fantasy">판타지</option>
                        <option value="romance">로맨스</option>
                        <option value="action">액션</option>
                        <option value="mystery">미스터리</option>
                        <option value="sf">SF</option>
                        <option value="horror">호러</option>
                        <option value="comedy">코미디</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>태그</label>
                    <input type="text" name="tags" class="input" placeholder="쉼표로 구분 (예: 던전, 성장, 모험)">
                </div>
                <div class="form-group">
                    <label>썸네일 URL</label>
                    <input type="url" name="thumbnailImage" class="input" placeholder="https://...">
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">저장</button>
                </div>
            </form>
        </div>
    </main>
    <%- include('../partials/footer') %>
    <script type="module">
        import apiClient from '/module/api.js';
        const novelId = '<%= novelId %>';
        const form = document.getElementById('novelForm');

        async function loadInitial() {
            try {
                const res = await apiClient.get(`/api/novel/v1/${novelId}`);
                const n = res.data;
                form.title.value = n.title || '';
                form.description.value = n.description || '';
                form.genre.value = n.genre || '';
                form.tags.value = Array.isArray(n.tags) ? n.tags.join(',') : '';
                form.thumbnailImage.value = n.thumbnailImage || '';
            } catch (e) {
                console.error(e);
            }
        }

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = new FormData(form);
            const body = {};
            if (data.get('title')) body.title = data.get('title');
            if (data.get('description')) body.description = data.get('description');
            body.genre = data.get('genre') || '';
            body.tags = (data.get('tags') || '').toString().split(',').map(s => s.trim()).filter(Boolean);
            if (data.get('thumbnailImage')) body.thumbnailImage = data.get('thumbnailImage');
            try {
                await apiClient.put(`/api/novel/v1/${novelId}`, body);
                window.location.href = `/novel/${novelId}`;
            } catch (err) {
                alert('수정 실패: ' + (err?.data?.message || err.message));
            }
        });

        loadInitial();
    </script>
</body>
</html>

