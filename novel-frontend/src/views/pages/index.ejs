<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/novel-card.css">
    <link rel="stylesheet" href="/css/index.css">
</head>
<body>
    <%- include('../partials/header', { currentSection: 'archive' }) %>
    
    <main class="main-content">
        <section class="hero-section">
            <div class="hero-content">
                <h1 class="hero-title">마법연구회 아카이브</h1>
                <p class="hero-description">다양한 이야기가 모이는 창작의 공간</p>
                
                <%- include('../partials/search-bar', { 
                    placeholder: '제목, 작가로 검색',
                    action: '/search',
                    showAdvanced: false
                }) %>
                
                <div class="hero-actions">
                    <a href="/novels" class="btn btn-primary btn-lg">
                        <span class="material-symbols-outlined">library_books</span>
                        소설 전체 보기
                    </a>
                    <a href="/novel/upload" class="btn btn-secondary btn-lg">
                        <span class="material-symbols-outlined">edit_note</span>
                        새 소설 작성
                    </a>
                </div>
            </div>
        </section>
        
        <section class="popular-section">
            <div class="section-header">
                <h2 class="section-title">인기 작품</h2>
                <div class="tab-buttons">
                    <button class="tab-btn active" data-range="now">실시간</button>
                    <button class="tab-btn" data-range="week">주간</button>
                </div>
            </div>
            
            <div id="popularGrid" class="novel-grid">
                <%- include('../partials/skeleton', { type: 'grid', count: 9 }) %>
            </div>
        </section>
        
        <div class="content-columns">
            <section class="news-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <span class="material-symbols-outlined">newspaper</span>
                        최신 소식
                    </h2>
                </div>
                
                <div id="newsList" class="news-list">
                    <%- include('../partials/skeleton', { type: 'list', count: 5 }) %>
                </div>
            </section>
            
            <section class="activity-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <span class="material-symbols-outlined">history</span>
                        내 활동
                    </h2>
                </div>
                
                <div id="activityList" class="activity-list">
                    <% if (locals.isAuthenticated) { %>
                        <%- include('../partials/skeleton', { type: 'list', count: 5 }) %>
                    <% } else { %>
                        <%- include('../partials/empty-state', {
                            icon: 'login',
                            title: '로그인이 필요합니다',
                            message: '활동 내역을 보려면 로그인하세요.',
                            showAction: true,
                            actionText: '로그인',
                            actionUrl: '/login',
                            actionIcon: 'login'
                        }) %>
                    <% } %>
                </div>
            </section>
        </div>
    </main>
    
    <%- include('../partials/footer') %>
    
    <script type="module">
        import apiClient from '/module/api.js';
        
        document.addEventListener('DOMContentLoaded', async function() {
            const popularGrid = document.getElementById('popularGrid');
            const newsList = document.getElementById('newsList');
            const activityList = document.getElementById('activityList');
            const tabButtons = document.querySelectorAll('.tab-btn');
            let currentRange = 'now';
            
            async function loadPopularNovels(range = 'now') {
                try {
                    popularGrid.innerHTML = '<%- include("../partials/skeleton", { type: "grid", count: 9 }) %>';
                    const response = await apiClient.get(`/api/v1/novels?sort=${range === 'week' ? 'likes' : 'views'}&limit=9`);
                    const items = response.data.novels || response.data || [];
                    if (items.length > 0) {
                        popularGrid.innerHTML = items.map(novel => `
                            <div class="novel-card-grid" onclick="window.location.href='/novel/${novel.novelId || novel._id || novel.id}'">
                                <div class="novel-thumbnail">
                                    ${novel.thumbnailImage ? 
                                        `<img src="${novel.thumbnailImage}" alt="${novel.title}" loading="lazy">` :
                                        `<div class="thumbnail-placeholder">
                                            <span class="material-symbols-outlined">menu_book</span>
                                        </div>`
                                    }
                                </div>
                                <div class="novel-info">
                                    <h3 class="novel-title">${novel.title}</h3>
                                    <p class="novel-author">${novel.author || '작가 미상'}</p>
                                    <div class="novel-meta">
                                        <span class="meta-item">
                                            <span class="material-symbols-outlined">visibility</span>
                                            ${formatNumber(novel.viewCount || novel.views || 0)}
                                        </span>
                                        <span class="meta-item">
                                            <span class="material-symbols-outlined">favorite</span>
                                            ${formatNumber(novel.likeCount || novel.likes || 0)}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        `).join('');
                    } else {
                        popularGrid.innerHTML = '<%- include("../partials/empty-state", { title: "작품이 없습니다", message: "아직 인기 작품이 없습니다." }) %>';
                    }
                } catch (error) {
                    console.error('Error loading popular novels:', error);
                    popularGrid.innerHTML = '<%- include("../partials/error-banner", { message: "인기 작품을 불러오는 중 오류가 발생했습니다." }) %>';
                }
            }
            
            async function loadNews() {
                try {
                    const response = await apiClient.get('/api/v1/novels?sort=recent&limit=20');
                    const items = response.data.novels || [];
                    if (items.length > 0) {
                        newsList.innerHTML = items.map(item => `
                            <div class="news-item">
                                <div class="news-icon">
                                    <span class="material-symbols-outlined">${getNewsIcon('update')}</span>
                                </div>
                                <div class="news-content">
                                    <p class="news-text">새 소설: ${item.title}</p>
                                    <span class="news-time">${formatTime(item.updatedAt || item.createdAt)}</span>
                                </div>
                            </div>
                        `).join('');
                    } else {
                        newsList.innerHTML = '<p class="empty-message">최신 소식이 없습니다.</p>';
                    }
                } catch (error) {
                    console.error('Error loading news:', error);
                }
            }
            
            async function loadActivities() {
                if (!localStorage.getItem('accessToken')) {
                    return;
                }
                
                try {
                    const me = await apiClient.get('/api/v1/auth/me');
                    const userid = me?.data?.user?.userid || me?.data?.userid || '';
                    if (!userid) return;
                    const response = await apiClient.get(`/api/v1/logs/users/${encodeURIComponent(userid)}/activity?limit=20`).catch(() => null);
                    const activities = response?.data?.activities || response?.data || [];
                    if (activities.length > 0) {
                        activityList.innerHTML = activities.map(activity => `
                            <div class="activity-item">
                                <div class="activity-icon">
                                    <span class="material-symbols-outlined">${getActivityIcon(activity.type || 'history')}</span>
                                </div>
                                <div class="activity-content">
                                    <p class="activity-text">${activity.description || activity.message || '활동 기록'}</p>
                                    <span class="activity-time">${formatTime(activity.createdAt || activity.time || new Date().toISOString())}</span>
                                </div>
                            </div>
                        `).join('');
                    } else {
                        activityList.innerHTML = '<%- include("../partials/empty-state", { icon: "history", title: "활동 내역이 없습니다", message: "아직 활동 내역이 없습니다.", showAction: false }) %>';
                    }
                } catch (error) {
                    console.error('Error loading activities:', error);
                }
            }
            
            function formatNumber(num) {
                if (num >= 1000000) return Math.floor(num / 1000000) + 'M';
                if (num >= 1000) return Math.floor(num / 1000) + 'K';
                return num.toString();
            }
            
            function formatTime(dateString) {
                const date = new Date(dateString);
                const now = new Date();
                const diff = now - date;
                
                const minutes = Math.floor(diff / 60000);
                if (minutes < 1) return '방금 전';
                if (minutes < 60) return `${minutes}분 전`;
                
                const hours = Math.floor(minutes / 60);
                if (hours < 24) return `${hours}시간 전`;
                
                const days = Math.floor(hours / 24);
                if (days < 7) return `${days}일 전`;
                
                return date.toLocaleDateString('ko-KR');
            }
            
            function getNewsIcon(type) {
                const icons = {
                    'new_novel': 'auto_stories',
                    'new_episode': 'library_add',
                    'popular_comment': 'trending_up',
                    'update': 'update',
                    'notice': 'campaign'
                };
                return icons[type] || 'newspaper';
            }
            
            function getActivityIcon(type) {
                const icons = {
                    'upload': 'upload',
                    'comment': 'comment',
                    'like': 'favorite',
                    'bookmark': 'bookmark',
                    'read': 'visibility'
                };
                return icons[type] || 'history';
            }
            
            tabButtons.forEach(button => {
                button.addEventListener('click', function() {
                    tabButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');
                    currentRange = this.dataset.range;
                    loadPopularNovels(currentRange);
                });
            });
            
            await Promise.all([
                loadPopularNovels(),
                loadNews(),
                loadActivities()
            ]);
        });
    </script>
</body>
</html>
