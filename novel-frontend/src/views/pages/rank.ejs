<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/component/style/buttons.css">
</head>
<body>
    <%- include('../partials/header', { currentSection: 'archive' }) %>
    <main class="main-content">
        <div class="container" style="padding:2rem 0;">
            <h1 class="page-title">랭킹</h1>
            <div id="rankList">
                <%- include('../partials/skeleton', { type: 'card', count: 10 }) %>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>
    <script type="module">
        import apiClient from '/module/api.js';
        async function init() {
            const container = document.getElementById('rankList');
            try {
                const response = await apiClient.get('/api/v1/novels?sort=likes&limit=20');
                const items = response?.data?.novels || response?.data || [];
                if (!items.length) {
                    container.innerHTML = `<%- include('../partials/empty-state', { icon: 'trending_up', title: '랭킹 데이터가 없습니다', message: '작품 활동이 쌓이면 집계됩니다.' }) %>`;
                    return;
                }
                container.innerHTML = items.map((novel, idx) => `
                    <div class="novel-preview-card" onclick="window.location.href='/novel/${novel.novelId || novel._id || novel.id}'" role="button" tabindex="0">
                        <div class="novel-thumbnail">
                            ${novel.thumbnailImage ? 
                                `<img src="${novel.thumbnailImage}" alt="${String(novel.title||'제목 없음').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#039;')} 썸네일" loading="lazy" onerror="this.src='/images/default-novel-cover.jpg'">` :
                                `<div class="thumbnail-placeholder"><span class="material-symbols-outlined">menu_book</span></div>`}
                        </div>
                        <div class="novel-info">
                            <div class="novel-header">
                                <h3 class="novel-title">${String(novel.title||'제목 없음').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#039;')}</h3>
                                <p class="novel-author"><span class="material-symbols-outlined">workspace_premium</span>#${idx+1}</p>
                            </div>
                            <div class="novel-meta">
                                <span class="meta-item"><span class="material-symbols-outlined">visibility</span>${novel.viewCount||0}</span>
                                <span class="meta-item"><span class="material-symbols-outlined">favorite</span>${novel.likeCount||0}</span>
                            </div>
                        </div>
                    </div>
                `).join('');
            } catch (e) {
                container.innerHTML = `<%- include('../partials/error-banner', { message: '랭킹 로딩 중 오류가 발생했습니다.' }) %>`
            }
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    </script>
</body>
</html>

