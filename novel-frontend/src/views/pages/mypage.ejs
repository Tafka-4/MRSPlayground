<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/component/style/buttons.css">
    <link rel="stylesheet" href="/component/style/cards.css">
    <link rel="stylesheet" href="/component/style/badges.css">
    <link rel="stylesheet" href="/component/style/navigation.css">
    <link rel="stylesheet" href="/css/novel-card.css">
    <link rel="stylesheet" href="/css/index.css">
</head>
<body>
    <%- include('../partials/header', { currentSection: 'archive' }) %>
    <main class="main-content">
        <div class="container">
            <div class="page">
                <div class="page-header">
                    <h1 class="page-title">마이페이지</h1>
                </div>
                <div class="section">
                    <div class="card">
                        <h2 style="margin:0 0 0.75rem;">내 정보</h2>
                        <div class="stack-h" style="align-items:center;">
                            <div class="user-avatar">
                                <img id="mypageAvatar" class="avatar-image" alt="avatar" style="display:none;width:48px;height:48px;border-radius:50%;object-fit:cover;">
                                <span class="material-symbols-outlined" id="mypageAvatarIcon">person</span>
                            </div>
                            <div class="stack-v" style="min-width:0;">
                                <div id="mypageName" style="font-weight:600;">게스트</div>
                                <div id="mypageRole" class="muted">로그인 필요</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-header">
                        <h2 class="section-title"><span class="material-symbols-outlined">menu_book</span>내 소설</h2>
                    </div>
                    <div id="myNovelsGrid" class="novel-grid">
                        <%- include('../partials/skeleton', { type: 'grid', count: 8, inline: true }) %>
                    </div>
                </div>

                <div class="content-columns">
                    <section class="news-section">
                        <div class="section-header">
                            <h2 class="section-title news-header"><span class="news-icon"><span class="material-symbols-outlined">campaign</span></span>알림</h2>
                        </div>
                        <div id="notificationsList" class="news-list">
                            <%- include('../partials/skeleton', { type: 'list', count: 5 }) %>
                        </div>
                    </section>

                    <section class="activity-section">
                        <div class="section-header">
                            <h2 class="section-title activity-header"><span class="activity-icon"><span class="material-symbols-outlined">history</span></span>최근 활동</h2>
                        </div>
                        <div id="activityList" class="activity-list">
                            <%- include('../partials/skeleton', { type: 'list', count: 5 }) %>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
<script type="module">
    import apiClient from '/module/api.js';
    async function ensureAccessToken() {
        let token = localStorage.getItem('accessToken');
        if (token) return token;
        try {
            const refreshed = await apiClient.post('/api/v1/auth/refresh');
            const access = refreshed?.data?.accessToken || refreshed?.accessToken;
            if (access) {
                localStorage.setItem('accessToken', access);
                return access;
            }
        } catch {}
        return null;
    }

    function escapeHtml(s) {
        return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
    }

    function formatTime(dateString) {
        const date = new Date(dateString);
        const now = new Date();
        const diff = now - date;
        const minutes = Math.floor(diff / 60000);
        if (minutes < 1) return '방금 전';
        if (minutes < 60) return `${minutes}분 전`;
        const hours = Math.floor(minutes / 60);
        if (hours < 24) return `${hours}시간 전`;
        const days = Math.floor(hours / 24);
        if (days < 7) return `${days}일 전`;
        return date.toLocaleDateString('ko-KR');
    }

    function formatNumber(num) {
        if (num >= 1000000) return Math.floor(num / 1000000) + 'M';
        if (num >= 1000) return Math.floor(num / 1000) + 'K';
        return (num||0).toString();
    }

    async function init() {
        const token = await ensureAccessToken();
        const nameEl = document.getElementById('mypageName');
        const roleEl = document.getElementById('mypageRole');
        const avatarImg = document.getElementById('mypageAvatar');
        const avatarIcon = document.getElementById('mypageAvatarIcon');
        const novelsGrid = document.getElementById('myNovelsGrid');
        const notificationsList = document.getElementById('notificationsList');
        const activityList = document.getElementById('activityList');

        if (!token) {
            roleEl.textContent = '로그인 필요';
            notificationsList.innerHTML = `<div class="empty-state compact"><div class="empty-state-icon"><span class="material-symbols-outlined">login</span></div><h3 class="empty-state-title">로그인이 필요합니다</h3></div>`;
            activityList.innerHTML = `<div class="empty-state compact"><div class="empty-state-icon"><span class="material-symbols-outlined">login</span></div><h3 class="empty-state-title">로그인이 필요합니다</h3></div>`;
            novelsGrid.innerHTML = `<div class="card"><div class="empty-message">로그인 후 내 소설을 확인할 수 있어요.</div></div>`;
            return;
        }

        let me;
        try {
            const meRes = await apiClient.get('/api/v1/auth/me', { headers: { 'Authorization': `Bearer ${token}` } });
            me = meRes?.data?.user || meRes?.data || {};
        } catch {}

        const username = me?.nickname || me?.username || '';
        const userid = me?.userid || '';
        if (username) nameEl.textContent = username;
        roleEl.textContent = me?.authority === 'admin' ? '관리자' : '사용자';
        const avatarSrc = me?.profileImage || me?.avatar || '';
        if (avatarSrc) {
            avatarImg.src = avatarSrc.startsWith('/uploads/') ? `https://api.magicresearches.com${avatarSrc}` : avatarSrc;
            avatarImg.style.display = 'inline-block';
            if (avatarIcon) avatarIcon.style.display = 'none';
        }

        async function loadMyNovels() {
            try {
                let res = null;
                if (userid) res = await apiClient.get(`/api/v1/novels/author/${encodeURIComponent(userid)}`).catch(() => null);
                if (!res && username) res = await apiClient.get(`/api/v1/novels/author/${encodeURIComponent(username)}`).catch(() => null);
                if (!res && userid) res = await apiClient.get(`/api/v1/novels?author=${encodeURIComponent(userid)}`).catch(() => null);
                if (!res && username) res = await apiClient.get(`/api/v1/novels?author=${encodeURIComponent(username)}`).catch(() => null);
                const items = res && (res.data?.novels || res.data || []);
                if (Array.isArray(items) && items.length) {
                    novelsGrid.innerHTML = items.slice(0,12).map(novel => `
                        <div class="novel-preview-card horizontal" onclick="window.location.href='/novel/${novel.novelId || novel._id || novel.id}'" role="button" tabindex="0">
                            <div class="novel-thumbnail">
                                ${novel.thumbnailImage ? 
                                    `<img src="${novel.thumbnailImage}" alt="${escapeHtml(novel.title||'제목 없음')} 썸네일" loading="lazy" onerror="this.src='/images/default-novel-cover.jpg'">` :
                                    `<div class="thumbnail-placeholder"><span class="material-symbols-outlined">menu_book</span></div>`}
                            </div>
                            <div class="novel-info">
                                <div class="novel-header">
                                    <h3 class="novel-title">${escapeHtml(novel.title||'제목 없음')}</h3>
                                    <p class="novel-author"><span class="material-symbols-outlined">person</span>${escapeHtml(novel.authorName || novel.author || username || '작가')}</p>
                                </div>
                                <div class="novel-meta">
                                    <span class="meta-item"><span class="material-symbols-outlined">visibility</span>${formatNumber(novel.viewCount||0)}</span>
                                    <span class="meta-item"><span class="material-symbols-outlined">favorite</span>${formatNumber(novel.likeCount||0)}</span>
                                </div>
                            </div>
                        </div>
                    `).join('');
                } else {
                    novelsGrid.innerHTML = `<div class="empty-state compact"><div class="empty-state-icon"><span class="material-symbols-outlined">menu_book</span></div><h3 class="empty-state-title">작성한 소설이 없어요</h3></div>`;
                }
            } catch (e) {
                novelsGrid.innerHTML = `<div class="card"><div class="empty-message">내 소설을 불러오는 중 오류가 발생했습니다.</div></div>`;
            }
        }

        async function loadNotifications() {
            try {
                let res = await apiClient.get('/api/v1/notifications/self?limit=20').catch(() => null);
                if (!res && userid) res = await apiClient.get(`/api/v1/users/${encodeURIComponent(userid)}/notifications?limit=20`).catch(() => null);
                if (!res && userid) res = await apiClient.get(`/api/v1/notifications?userId=${encodeURIComponent(userid)}&limit=20`).catch(() => null);
                const items = res && (res.data?.notifications || res.data?.items || res.data || []);
                if (Array.isArray(items) && items.length) {
                    notificationsList.innerHTML = items.slice(0,20).map(n => `
                        <div class="news-item">
                            <div class="news-icon"><span class="material-symbols-outlined">campaign</span></div>
                            <div class="news-content">
                                <p class="news-text">${escapeHtml(n.message || n.title || '알림')}</p>
                                <span class="news-time">${formatTime(n.createdAt || n.time || new Date().toISOString())}</span>
                            </div>
                        </div>
                    `).join('');
                } else {
                    notificationsList.innerHTML = `<div class="empty-state compact"><div class="empty-state-icon"><span class="material-symbols-outlined">notifications</span></div><h3 class="empty-state-title">새 알림이 없어요</h3></div>`;
                }
            } catch (e) {
                notificationsList.innerHTML = `<div class="card"><div class="empty-message">알림을 불러오는 중 오류가 발생했습니다.</div></div>`;
            }
        }

        async function loadActivities() {
            try {
                let res = userid ? await apiClient.get(`/api/v1/logs/users/${encodeURIComponent(userid)}/activity?limit=20`).catch(() => null) : null;
                const logs = res && (res.data?.activities || res.data?.logs || res.data || []);
                if (Array.isArray(logs) && logs.length) {
                    activityList.innerHTML = logs.slice(0,20).map(a => `
                        <div class="activity-item">
                            <div class="activity-icon"><span class="material-symbols-outlined">${escapeHtml(a.type || 'history')}</span></div>
                            <div class="activity-content">
                                <p class="activity-text">${escapeHtml(a.description || a.message || '활동 기록')}</p>
                                <span class="activity-time">${formatTime(a.createdAt || a.time || new Date().toISOString())}</span>
                            </div>
                        </div>
                    `).join('');
                } else {
                    activityList.innerHTML = `<div class="empty-state compact"><div class="empty-state-icon"><span class="material-symbols-outlined">history</span></div><h3 class="empty-state-title">아직 활동이 없어요</h3></div>`;
                }
            } catch (e) {
                activityList.innerHTML = `<div class="card"><div class="empty-message">활동 내역을 불러오는 중 오류가 발생했습니다.</div></div>`;
            }
        }

        await Promise.all([
            loadMyNovels(),
            loadNotifications(),
            loadActivities()
        ]);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
</script>

