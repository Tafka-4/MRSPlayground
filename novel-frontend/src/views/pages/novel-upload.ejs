<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <%- include('../partials/head-assets') %>
</head>
<body>
    <%- include('../partials/header', { currentSection: 'archive' }) %>
    <main class="main-content">
        <div class="container">
            <div class="page" style="max-width:720px;margin:0 auto;">
                <div class="page-header">
                    <h1 class="page-title">소설 업로드</h1>
                </div>
            <form id="novelForm" class="form" enctype="multipart/form-data">
                <div class="input-group">
                    <label for="title">제목</label>
                    <div class="search-input-wrapper">
                        <span class="material-symbols-outlined search-icon">title</span>
                        <input id="title" name="title" type="text" class="search-input" placeholder="제목을 입력하세요" required maxlength="100">
                    </div>
                </div>
                <div class="input-group">
                    <label for="description">설명</label>
                    <div class="search-input-wrapper">
                        <span class="material-symbols-outlined search-icon">notes</span>
                        <textarea id="description" name="description" class="search-input" rows="5" placeholder="작품 설명을 입력하세요" required maxlength="500" style="resize:none;border-radius: var(--border-radius);"></textarea>
                    </div>
                </div>
                <div class="input-group">
                    <label for="tags">태그</label>
                    <div class="search-input-wrapper">
                        <span class="material-symbols-outlined search-icon">sell</span>
                        <input id="tags" name="tags" type="text" class="search-input" placeholder="쉼표로 구분 (예: 던전, 성장, 모험)">
                    </div>
                </div>
                <div class="input-group">
                    <label for="thumbnailFile">썸네일 업로드</label>
                    <div class="stack-h" style="align-items:center;gap:0.5rem;">
                        <input id="thumbnailFile" name="thumbnail" type="file" accept="image/*" style="display:none;">
                        <button type="button" id="thumbnailPick" class="btn btn-secondary">
                            <span class="material-symbols-outlined">upload</span>
                            파일 선택
                        </button>
                        <span id="thumbnailName" class="muted">선택된 파일 없음</span>
                    </div>
                </div>

                <div class="input-group">
                    <label for="visibility">공개 범위</label>
                    <div class="search-input-wrapper">
                        <span class="material-symbols-outlined search-icon">lock_open</span>
                        <select id="visibility" name="visibility" class="search-input" style="padding-left:2.5rem;appearance:auto;">
                            <option value="public">공개</option>
                            <option value="code">코드 소지자만</option>
                            <option value="private">본인만</option>
                        </select>
                    </div>
                </div>

                <div class="input-group" id="accessCodeWrap" style="display:none;">
                    <label for="accessCode">접근 코드</label>
                    <div class="search-input-wrapper">
                        <span class="material-symbols-outlined search-icon">key</span>
                        <input id="accessCode" name="accessCode" type="text" class="search-input" placeholder="코드 소지자만 선택 시 입력">
                    </div>
                </div>
                <div class="form-actions stack-h" style="justify-content:flex-end;">
                    <button type="button" class="btn btn-secondary" onclick="history.back()">
                        <span class="material-symbols-outlined">arrow_back</span>
                        취소
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <span class="material-symbols-outlined">save</span>
                        등록
                    </button>
                </div>
            </form>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>
    <script type="module">
        import apiClient from '/module/api.js';
        const form = document.getElementById('novelForm');
        const visibility = document.getElementById('visibility');
        const accessCodeWrap = document.getElementById('accessCodeWrap');
        const fileInput = document.getElementById('thumbnailFile');
        const filePick = document.getElementById('thumbnailPick');
        const fileName = document.getElementById('thumbnailName');
        filePick?.addEventListener('click', ()=> fileInput?.click());
        fileInput?.addEventListener('change', ()=> { fileName.textContent = fileInput.files?.[0]?.name || '선택된 파일 없음'; });
        visibility?.addEventListener('change', () => {
            accessCodeWrap.style.display = visibility.value === 'code' ? 'block' : 'none';
        });
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = new FormData(form);
            const body = {
                title: data.get('title'),
                description: data.get('description'),
                tags: (data.get('tags') || '').toString().split(',').map(s => s.trim()).filter(Boolean),
                visibility: data.get('visibility') || 'public',
                accessCode: data.get('accessCode') || ''
            };
            try {
                let response = await apiClient.post('/api/v1/novels', body);
                const novel = response.data.novel || response.data;
                const file = data.get('thumbnail');
                if (file && file instanceof File) {
                    const fd = new FormData();
                    fd.append('file', file);
                    await apiClient.post(`/api/v1/novels/${novel.novelId || novel._id || novel.id}/thumbnail-image`, fd);
                }
                window.location.href = `/novel/${novel.novelId || novel._id || novel.id}`;
            } catch (err) {
                alert('업로드 실패: ' + (err?.data?.message || err.message));
            }
        });
    </script>
</body>
</html>

