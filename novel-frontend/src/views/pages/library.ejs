<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <%- include('../partials/head-assets') %>
</head>
<body>
    <%- include('../partials/header', { currentSection: 'archive' }) %>
    <main class="main-content">
        <div class="container">
            <div class="page">
                <div class="page-header">
                    <h1 class="page-title">내 서재</h1>
                </div>
                <div class="muted stack-h">
                    <span>유형: <%= locals.type %></span>
                    <span>정렬: <%= locals.sort %></span>
                </div>
                <div class="section">
                    <div id="libraryList">
                        <%- include('../partials/skeleton', { type: 'card', count: 10 }) %>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>

