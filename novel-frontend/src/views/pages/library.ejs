<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/component/style/buttons.css">
    <link rel="stylesheet" href="/component/style/cards.css">
    <link rel="stylesheet" href="/component/style/badges.css">
    <link rel="stylesheet" href="/component/style/navigation.css">
</head>
<body>
    <%- include('../partials/header', { currentSection: 'archive' }) %>
    <main class="main-content">
        <div class="container" style="padding:2rem 0;">
            <h1 class="page-title">내 서재</h1>
            <div class="filters" style="margin-bottom:1rem;">
                <span>유형: <%= locals.type %></span>
                <span style="margin-left:8px;">정렬: <%= locals.sort %></span>
            </div>
            <div id="libraryList">
                <%- include('../partials/skeleton', { type: 'card', count: 10 }) %>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>

