<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <%- include('../partials/header', { currentSection: 'archive' }) %>
    <main class="main-content">
        <div class="container" style="padding:2rem 0;">
            <h1 class="page-title">에피소드</h1>
            <div class="meta" style="margin-bottom:1rem;">Novel: <%= locals.novelId %> / Episode: <%= locals.episodeId %></div>
            <div id="episodeDetail">
                <%- include('../partials/skeleton', { type: 'card', count: 2 }) %>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
<script type="module">
    import apiClient from '/module/api.js';
    const container = document.getElementById('episodeDetail');
    const episodeId = '<%= locals.episodeId %>';
    async function load() {
        try {
            const res = await apiClient.get(`/api/v1/episodes/${episodeId}`);
            const e = res.data.episode || res.data;
            container.innerHTML = `
                <article>
                    <h2 style=\"margin:0 0 12px;\">${e.title || 'Untitled'}</h2>
                    <div class=\"content\" style=\"white-space:pre-wrap;\">${e.content || ''}</div>
                    ${e.authorComment ? `<hr/><div class=\"author-comment\">${e.authorComment}</div>` : ''}
                    <div style=\"margin-top:12px;display:flex;gap:8px;\">
                        <button id=\"likeBtn\" class=\"btn btn-text\">👍 ${e.likeCount || 0}</button>
                        <button id=\"dislikeBtn\" class=\"btn btn-text\">👎 ${e.dislikeCount || 0}</button>
                    </div>
                </article>
            `;
            document.getElementById('likeBtn')?.addEventListener('click', async () => {
                try { await apiClient.post(`/api/v1/episodes/${episodeId}/like`); location.reload(); } catch {}
            });
            document.getElementById('dislikeBtn')?.addEventListener('click', async () => {
                try { await apiClient.post(`/api/v1/episodes/${episodeId}/dislike`); location.reload(); } catch {}
            });
        } catch (err) {
            container.innerHTML = `<div class="error">로딩 실패</div>`;
        }
    }
    load();
</script>

