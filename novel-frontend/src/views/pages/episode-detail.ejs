<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/component/style/buttons.css">
    <link rel="stylesheet" href="/component/style/cards.css">
    <link rel="stylesheet" href="/component/style/badges.css">
    <link rel="stylesheet" href="/component/style/navigation.css">
</head>
<body>
    <%- include('../partials/header', { currentSection: 'archive' }) %>
    <main class="main-content">
        <div class="container">
            <div class="page">
                <div class="page-header">
                    <h1 class="page-title">에피소드</h1>
                </div>
                <div class="muted">Novel: <%= locals.novelId %> / Episode: <%= locals.episodeId %></div>
                <div class="section">
                    <div id="episodeDetail">
                        <%- include('../partials/skeleton', { type: 'card', count: 2 }) %>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
<script type="module">
    import apiClient from '/module/api.js';
    const container = document.getElementById('episodeDetail');
    const episodeId = '<%= locals.episodeId %>';
    async function load() {
        try {
            const res = await apiClient.get(`/api/v1/episodes/${episodeId}`);
            const e = res.data.episode || res.data;
            container.innerHTML = `
                <article class=\"card\">
                    <h2 class=\"page-title\">${String(e.title||'Untitled').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}</h2>
                    <div class=\"content\" style=\"white-space:pre-wrap;\">${String(e.content||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}</div>
                    ${e.authorComment ? `<div class=\"section\"><div class=\"muted\">${String(e.authorComment).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}</div></div>` : ''}
                    <div class=\"stack-h\">
                        <button id=\"likeBtn\" class=\"btn btn-secondary\">👍 ${e.likeCount || 0}</button>
                        <button id=\"dislikeBtn\" class=\"btn btn-secondary\">👎 ${e.dislikeCount || 0}</button>
                    </div>
                </article>
            `;
            document.getElementById('likeBtn')?.addEventListener('click', async () => {
                try { await apiClient.post(`/api/v1/episodes/${episodeId}/like`); location.reload(); } catch {}
            });
            document.getElementById('dislikeBtn')?.addEventListener('click', async () => {
                try { await apiClient.post(`/api/v1/episodes/${episodeId}/dislike`); location.reload(); } catch {}
            });
        } catch (err) {
            container.innerHTML = `<div class="error">로딩 실패</div>`;
        }
    }
    load();
</script>

