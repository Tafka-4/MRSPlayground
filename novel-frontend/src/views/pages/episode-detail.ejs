<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <%- include('../partials/head-assets') %>
</head>
<body>
    <%- include('../partials/header', { currentSection: 'archive' }) %>
    <main class="main-content">
        <div class="container">
            <div class="page">
                <div class="page-header">
                    <h1 class="page-title">에피소드</h1>
                </div>
                <div class="muted">Novel: <%= locals.novelId %> / Episode: <%= locals.episodeId %></div>
                <div class="section">
                    <div id="episodeDetail">
                        <%- include('../partials/skeleton', { type: 'card', count: 2 }) %>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
<script type="module">
    import apiClient from '/module/api.js';
    const container = document.getElementById('episodeDetail');
    const episodeId = '<%= locals.episodeId %>';
    const novelId = '<%= locals.novelId %>';
    async function promptAccessCode() {
        const code = window.prompt('접근 코드가 필요합니다. 코드를 입력하세요.');
        return (code || '').trim();
    }
    function withAccessCode(url) {
        const saved = localStorage.getItem(`novel_code_${novelId}`) || '';
        if (!saved) return url;
        const joiner = url.includes('?') ? '&' : '?';
        return `${url}${joiner}code=${encodeURIComponent(saved)}`;
    }
    async function load() {
        try {
            const res = await apiClient.get(withAccessCode(`/api/v1/episodes/${episodeId}`));
            const e = res.data.episode || res.data;
            container.innerHTML = `
                <article class=\"card\">
                    <h2 class=\"page-title\">${String(e.title||'Untitled').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}</h2>
                    <div class=\"content\" style=\"white-space:pre-wrap;\">${String(e.content||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}</div>
                    ${e.authorComment ? `<div class=\"section\"><div class=\"muted\">${String(e.authorComment).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}</div></div>` : ''}
                    <div class=\"stack-h\">
                        <button id=\"likeBtn\" class=\"btn btn-secondary\">👍 ${e.likeCount || 0}</button>
                        <button id=\"dislikeBtn\" class=\"btn btn-secondary\">👎 ${e.dislikeCount || 0}</button>
                    </div>
                    <div class=\"section\"><div id=\"authorActions\" class=\"stack-h\" style=\"gap:.5rem;flex-wrap:wrap;\"></div></div>
                </article>
            `;
            document.getElementById('likeBtn')?.addEventListener('click', async () => {
                try { await apiClient.post(`/api/v1/episodes/${episodeId}/like`); location.reload(); } catch {}
            });
            document.getElementById('dislikeBtn')?.addEventListener('click', async () => {
                try { await apiClient.post(`/api/v1/episodes/${episodeId}/dislike`); location.reload(); } catch {}
            });
            try {
                const me = await apiClient.get('/api/v1/auth/me');
                const myId = me?.data?.user?.userid || me?.data?.userid;
                if (myId && myId === e.author) {
                    const actions = document.getElementById('authorActions');
                    if (actions) {
                        actions.innerHTML = `
                            <a href="/novel/${novelId}/episode/${episodeId}/edit" class="btn btn-secondary"><span class="material-symbols-outlined">edit</span>수정</a>
                            <button id="btnDeleteEpisode" class="btn btn-danger"><span class="material-symbols-outlined">delete</span>삭제</button>
                        `;
                        const del = document.getElementById('btnDeleteEpisode');
                        if (del) del.addEventListener('click', async () => {
                            if (!confirm('에피소드를 삭제하시겠습니까?')) return;
                            try { await apiClient.delete(`/api/v1/episodes/${episodeId}`); window.location.href = `/novel/${novelId}`; } catch { alert('삭제 실패'); }
                        });
                    }
                }
            } catch {}
        } catch (err) {
            const status = err?.status || 0;
            if (status === 403) {
                const code = await promptAccessCode();
                if (code) {
                    localStorage.setItem(`novel_code_${novelId}`, code);
                    return load();
                }
                container.innerHTML = `<div class="error">접근이 제한된 작품입니다.</div>`;
                return;
            }
            if (status === 401) {
                container.innerHTML = `<div class="error">로그인이 필요합니다.</div>`;
                return;
            }
            container.innerHTML = `<div class="error">로딩 실패</div>`;
        }
    }
    load();
</script>

