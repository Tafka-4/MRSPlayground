<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
    <%- include('../partials/head-assets') %>
</head>
<body>
    <%- include('../partials/header', { currentSection: 'archive' }) %>
    <main class="main-content">
        <div class="container">
            <div class="page">
                <div class="page-header">
                    <h1 class="page-title">검색</h1>
                </div>
                <div class="page-controls">
                    <div class="search-section" style="flex:1;max-width:700px;">
                        <%- include('../partials/search-bar', { 
                            placeholder: '제목, 작가, 태그로 검색',
                            value: locals.query || '',
                            action: '/search',
                            showAdvanced: true,
                            genre: locals.genre || '',
                            tags: locals.tags || []
                        }) %>
                    </div>
                </div>
                <div class="section">
                    <div id="searchResult" class="novel-list">
                        <%- include('../partials/skeleton', { type: 'card', count: 10 }) %>
                    </div>
                    <div id="paginationContainer"></div>
                </div>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>
    <script type="module">
        import apiClient from '/module/api.js';
        async function init() {
            const result = document.getElementById('searchResult');
            const paginationContainer = document.getElementById('paginationContainer');

            const urlParams = new URLSearchParams(window.location.search);
            const sort = urlParams.get('sort') || 'updated';
            const query = urlParams.get('query') || urlParams.get('q') || '';
            const page = parseInt(urlParams.get('page') || '1');
            const size = parseInt(urlParams.get('size') || '10');
            const genre = urlParams.get('genre') || '';
            const tags = urlParams.get('tags') || '';

            async function load() {
                result.innerHTML = `<%- include('../partials/skeleton', { type: 'card', count: 10 }) %>`;
                let apiUrl = `/api/v1/novels?sort=${sort}&page=${page}&limit=${size}`;
                if (query) apiUrl += `&query=${encodeURIComponent(query)}`;
                if (genre) apiUrl += `&genre=${encodeURIComponent(genre)}`;
                if (tags) apiUrl += `&tags=${encodeURIComponent(tags)}`;
                try {
                    const response = await apiClient.get(apiUrl);
                    const items = (response && response.data && Array.isArray(response.data.novels)) ? response.data.novels : (Array.isArray(response?.data) ? response.data : []);
                    if (items.length) {
                        result.innerHTML = items.map(novel => `
                        <div class="novel-preview-card" onclick="window.location.href='/novel/${novel.novelId || novel._id || novel.id}'" role="button" tabindex="0">
                            <div class="novel-thumbnail">
                                ${novel.thumbnailImage ? `<img src="${novel.thumbnailImage}" alt="${String(novel.title||'제목 없음').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#039;')} 썸네일" loading="lazy" onerror="this.src='/images/default-novel-cover.jpg'">` : `
                                <div class="thumbnail-placeholder">
                                    <span class="material-symbols-outlined">menu_book</span>
                                </div>`}
                            </div>
                            <div class="novel-info">
                                <div class="novel-header">
                                    <h3 class="novel-title">${String(novel.title||'제목 없음').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#039;')}</h3>
                                    <p class="novel-author"><span class="material-symbols-outlined">person</span>${String(novel.authorName || novel.author || '작가 미상').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#039;')}</p>
                                </div>
                                ${novel.description ? `<div class="novel-description">${String(novel.description).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').slice(0,30)}${novel.description.length>30?'...':''}</div>` : ''}
                                <div class="novel-meta">
                                    <span class="meta-item"><span class="material-symbols-outlined">visibility</span>${(novel.viewCount || 0)}</span>
                                    <span class="meta-item"><span class="material-symbols-outlined">favorite</span>${(novel.likeCount || 0)}</span>
                                    ${novel.genre ? `<span class="meta-item genre-tag">${String(novel.genre).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}</span>` : ''}
                                    ${Array.isArray(novel.tags) && novel.tags.length ? `${novel.tags.slice(0,3).map(t => `<span class=\"meta-item genre-tag\">${String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}</span>`).join('')}` : ''}
                                    ${novel.episodeCount ? `<span class="meta-item"><span class="material-symbols-outlined">library_books</span>${novel.episodeCount}화</span>` : ''}
                                </div>
                                ${novel.updatedAt ? `<div class="novel-date"><span class="date-label">최근 업데이트:</span><span class="date-value">${new Date(novel.updatedAt).toLocaleDateString('ko-KR')}</span></div>` : ''}
                            </div>
                        </div>`).join('');

                        const totalPages = response.data?.totalPages || Math.ceil((response.data?.total || 0) / size);
                        if (totalPages > 1) {
                            paginationContainer.innerHTML = getPaginationHTML(page, totalPages);
                        } else {
                            paginationContainer.innerHTML = '';
                        }
                    } else {
                        result.innerHTML = `<%- include('../partials/empty-state', { icon: 'search', title: '검색 결과가 없습니다', message: '검색 조건을 바꿔보세요.' }) %>`;
                        paginationContainer.innerHTML = '';
                    }
                } catch (e) {
                    console.error(e);
                    result.innerHTML = `<%- include('../partials/error-banner', { message: '검색 중 오류가 발생했습니다.', showRetry: true }) %>`;
                }
            }

            function getPaginationHTML(currentPage, totalPages) {
                let html = '<nav class="pagination-container"><ul class="pagination">';
                const qp = (p) => `?page=${p}&sort=${sort}${query ? '&query=' + encodeURIComponent(query) : ''}${genre ? '&genre=' + encodeURIComponent(genre) : ''}${tags ? '&tags=' + encodeURIComponent(tags) : ''}`;
                html += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}"><a href="${qp(1)}" class="page-link"><span class="material-symbols-outlined">first_page</span></a></li>`;
                html += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}"><a href="${qp(Math.max(1, currentPage-1))}" class="page-link"><span class="material-symbols-outlined">chevron_left</span></a></li>`;
                const maxVisible = 5;
                const half = Math.floor(maxVisible/2);
                let start = Math.max(1, currentPage - half);
                let end = Math.min(totalPages, start + maxVisible - 1);
                if (end - start < maxVisible - 1) start = Math.max(1, end - maxVisible + 1);
                for (let i = start; i <= end; i++) {
                    html += `<li class="page-item ${i === currentPage ? 'active' : ''}"><a href="${qp(i)}" class="page-link">${i}</a></li>`;
                }
                html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}"><a href="${qp(Math.min(totalPages, currentPage+1))}" class="page-link"><span class="material-symbols-outlined">chevron_right</span></a></li>`;
                html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}"><a href="${qp(totalPages)}" class="page-link"><span class="material-symbols-outlined">last_page</span></a></li>`;
                html += '</ul></nav>';
                return html;
            }

            await load();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    </script>
</body>
</html>

