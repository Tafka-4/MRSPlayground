<!DOCTYPE html>
<html lang="ko">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Novel Frontend</title>
        <script src="/config.js"></script>
        <script type="module">
            import api from '/public/module/api.js';
            window.testNovel = async () => {
            try {
                const res = await api.get('/api/v1/health');
                alert('OK: ' + JSON.stringify(res));
            } catch (e) {
                alert('ERR: ' + (e?.message || 'unknown'));
            }
            };
            window.testAuth = async () => {
            try {
                const res = await api.get('/api/v1/auth/me');
                alert('AUTH OK: ' + JSON.stringify(res));
            } catch (e) {
                alert('AUTH ERR: ' + (e?.message || 'unauthorized'));
            }
            };
            window.testNovels = async () => {
            try {
                const res = await api.get('/api/v1/novels');
                alert('NOVELS OK: ' + JSON.stringify(res));
            } catch (e) {
                alert('NOVELS ERR: ' + (e?.message || 'unknown'));
            }
            };
        </script>
    </head>
    <body>
        <h1>Novel Frontend</h1>
        <p>CONSTRUCTION: Novel Frontend</p>
        <button onclick="testNovel()">/api/v1/health (user-api) 호출 테스트</button>
        <button onclick="testNovels()">/api/v1/novels (novel-api) 테스트</button>
        <button onclick="testAuth()">/api/v1/auth/me 인증 테스트</button>
    </body>
</html>


